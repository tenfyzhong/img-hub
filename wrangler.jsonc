{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "img-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/pub/*",
      "/file/*",
      "/text/*",
      "/pub_*"
    ]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
